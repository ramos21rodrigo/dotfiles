[include]
  path = ~/personal/.gitconfig
[includeIf "gitdir:~/Documents/"]
  path = ~/ctw/.gitconfig
[includeIf "gitdir:/android/"]
  path = ~/ctw/.gitconfig

[core]
	editor = nvim
[credential]
	helper = store
[init]
	defaultBranch = master
[url "git@cc-github.bmwgroup.net:"]
	insteadOf = https://cc-github.bmwgroup.net/
[pull]
	rebase = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[http "http://asc-repo.bmwgroup.net"]
